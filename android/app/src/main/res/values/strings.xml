<?xml version="1.0" encoding="utf-8"?>
<!-- Texts Android shows outside the app's own screens (notifications, the floating
     window's buttons). The app's screens use lib/l10n/app_en.arb. A translation goes in
     res/values-<language>/strings.xml with the same names. -->
<resources>
    <string name="notification_channel_downloads">Downloads</string>
    <string name="notification_preparing">Preparing download</string>
    <!-- %1$d: number of the file being downloaded; %2$d: how many in total. -->
    <string name="notification_downloading">Downloading %1$d of %2$d</string>
    <!-- %1$s: file name. Shown while fast download keeps recording paused. -->
    <string name="notification_recording_paused">%1$s · recording paused</string>
    <string name="pip_play">Play</string>
    <string name="pip_pause">Pause</string>
    <string name="pip_back">Back 10 seconds</string>
    <string name="pip_forward">Forward 10 seconds</string>
    <!-- Background clock sync. %1$s: the camera's Wi-Fi name, or a time (HH:mm). -->
    <string name="channel_watch">Background clock sync</string>
    <string name="channel_alerts">Camera alerts</string>
    <string name="watch_title">Camera clock sync</string>
    <string name="watch_waiting">Waiting for %1$s</string>
    <string name="watch_setting_clock">Setting %1$s\'s clock…</string>
    <string name="watch_synced">Clock set at %1$s</string>
    <string name="watch_synced_new_clip">Clock set at %1$s · new clip started</string>
    <string name="watch_failed">Could not set the clock: %1$s</string>
    <string name="watch_standby">Syncs when %1$s next starts</string>
    <string name="alert_not_recording">The camera is NOT recording</string>
    <string name="alert_not_recording_text">It did not start again after the clock was set.</string>
    <string name="alert_start_recording">Start recording</string>
</resources>
