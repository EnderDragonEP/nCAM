<?xml version="1.0" encoding="utf-8"?>
<!-- The camera only speaks plain HTTP. Cleartext is allowed for its address, and for the
     app's own stream relay on the phone itself (StreamProxy), and nothing else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.254</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
